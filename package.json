{
  "name": "artix-checkupdates",
  "version": "1.3.2",
  "description": "nodejs wrapper for artix-checkupdates",
  "keywords": [
    "artix",
    "artixlinux"
  ],
  "homepage": "https://github.com/CorySanin/node-artix-checkupdates#readme",
  "bugs": {
    "url": "https://github.com/CorySanin/node-artix-checkupdates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorySanin/node-artix-checkupdates.git"
  },
  "license": "MIT",
  "author": {
    "name": "Cory Sanin",
    "email": "corysanin@artixlinux.org",
    "url": "https://sanin.dev/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./distribution/src/index.d.ts",
      "import": "./distribution/src/index.js"
    }
  },
  "main": "./distribution/src/index.js",
  "types": "./distribution/src/index.d.ts",
  "files": [
    "distribution",
    "!distribution/**/*.js.map"
  ],
  "scripts": {
    "build": "tsc && rm -rf distribution/test",
    "clean": "rm -rf ./distribution",
    "watch": "tsc -w",
    "test": "vitest"
  },
  "dependencies": {
    "spawn-but-with-promises": "^1.0.4"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "8.1.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}